 #
 # output
 #
 ddxmode 2
 filespectrum n p d t h a
 fileddxa p 20.
 fileddxa p 70.
 fileddxa p 110.
 fileddxa d 20.
 fileddxa d 70.
 fileddxa d 110.
 fileddxa t 20.
